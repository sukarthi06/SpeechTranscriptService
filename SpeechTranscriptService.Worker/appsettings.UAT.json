{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/audio/transcriptions"
  },
  "RecordingGrpcService": {
    "Address": ""
  },
  "RabbitMQ": {
    "Host": "",
    "Port": "5671",
    "VirtualHost": "",
    "Username": "",
    "Password": "",
    "PrefetchCount": 1
  },
  "Azure": {
    "StorageConnectionString": "",
    "SourceContainer": "audio-captures",
    "WavContainer": "wav-converts",
    "TranscriptStorage": "transcripts"
  },
  "Otlp": {
    "Endpoint": "",
    "Protocol": "",
    "TracesEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
